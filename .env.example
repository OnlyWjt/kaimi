KAIMI_PUBLIC_BASE_URL=https://kaimi.example.com
KAIMI_SECRET_KEY=please-change-this-long-random-string
# 外部 Cron 每分钟 POST /api/internal/jobs 时使用的 Bearer 密钥（至少 24 位）
KAIMI_CRON_SECRET=please-change-this-cron-secret
KAIMI_DATABASE_URL=file:./data/kaimi.db
KAIMI_ADMIN_USER=admin
KAIMI_ADMIN_PASSWORD=kaimi-change-me
# 反代由可信代理独占写入的来源头，限流按它认客户端。nginx / OpenResty 填 x-real-ip，
# Cloudflare 填 cf-connecting-ip。留空则从 X-Forwarded-For 末尾数 KAIMI_TRUSTED_PROXY_HOPS 跳（默认 1）。
# KAIMI_CLIENT_IP_HEADER=x-real-ip
# 可选：没有后台卡台账户时，用环境变量兜底（与 danew_card_cdk 同名）
# CARD_API_BASE=https://your-card.example.com
# CARD_API_KEY=sk_xxxxxxxxxxxx
